{
	"name": "poptab",
	"version": "1.2.2",
	"description": "CLI tool and library to clean up specific browser tabs.",
	"keywords": [
		"browser",
		"tabs",
		"cli",
		"npm-package"
	],
	"homepage": "https://github.com/kitschpatrol/poptab",
	"bugs": "https://github.com/kitschpatrol/poptab/issues",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/kitschpatrol/poptab.git"
	},
	"license": "MIT",
	"author": {
		"name": "Eric Mika",
		"email": "eric@ericmika.com",
		"url": "https://ericmika.com"
	},
	"sideEffects": false,
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/lib/index.d.ts",
			"import": "./dist/lib/index.js"
		}
	},
	"main": "./dist/lib/index.js",
	"module": "./dist/lib/index.js",
	"types": "./dist/lib/index.d.ts",
	"bin": {
		"poptab": "dist/bin/cli.js"
	},
	"files": [
		"dist/*"
	],
	"scripts": {
		"build": "tsdown",
		"clean-deep": "shx rm -f pnpm-lock.yaml && git clean -fdX -e !.claude/",
		"fix": "ksc fix",
		"lint": "ksc lint",
		"prepare": "skills experimental_sync -y -f",
		"release": "bumpp --commit 'Release: %s' && pnpm build && pnpm publish --otp $(op item get npm --otp) && brewpub --tap kitschpatrol/tap",
		"test": "vitest run"
	},
	"dependencies": {
		"@sindresorhus/is": "^8.1.0",
		"@types/node": "~24.13.6",
		"@types/yargs": "^17.0.35",
		"defu": "^6.1.7",
		"nano-spawn": "^2.1.0",
		"yargs": "^18.2.0"
	},
	"devDependencies": {
		"@arethetypeswrong/core": "^0.18.5",
		"@kitschpatrol/shared-config": "^8.12.1",
		"brewpub": "^0.5.0",
		"bumpp": "^12.3.0",
		"mdat-plugin-cli-help": "^3.4.0",
		"publint": "^0.3.25",
		"shx": "^0.4.0",
		"skills": "^1.7.0",
		"tsdown": "^0.23.0",
		"typescript": "~6.0.3",
		"vitest": "^5.0.3"
	},
	"packageManager": "pnpm@12.9.1",
	"engines": {
		"node": "^24.16.0 || >=26.0.0"
	},
	"devEngines": {
		"runtime": {
			"name": "node",
			"version": ">=26.8.2"
		}
	}
}

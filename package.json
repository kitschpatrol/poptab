{
	"name": "poptab",
	"version": "1.2.3",
	"description": "CLI tool and library to clean up specific browser tabs.",
	"keywords": [
		"browser",
		"tabs",
		"cli",
		"npm-package",
		"homebrew-formula"
	],
	"homepage": "https://github.com/kitschpatrol/poptab",
	"bugs": "https://github.com/kitschpatrol/poptab/issues",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/kitschpatrol/poptab.git"
	},
	"license": "MIT",
	"author": {
		"name": "Eric Mika",
		"email": "eric@ericmika.com",
		"url": "https://ericmika.com"
	},
	"sideEffects": false,
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/lib/index.d.ts",
			"import": "./dist/lib/index.js"
		}
	},
	"main": "./dist/lib/index.js",
	"module": "./dist/lib/index.js",
	"types": "./dist/lib/index.d.ts",
	"bin": {
		"poptab": "dist/bin/cli.js"
	},
	"files": [
		"dist"
	],
	"scripts": {
		"build": "tsdown",
		"clean-deep": "shx rm -f pnpm-lock.yaml && git clean -fdX",
		"fix": "pnpm build && ksc fix",
		"lint": "pnpm build && ksc lint",
		"release": "bumpp --commit 'Release: %s' --all --execute 'chagent' && pnpm build && pnpm publish --otp $(op item get npm --otp) && brewpub --tap kitschpatrol/tap",
		"test": "vitest run"
	},
	"dependencies": {
		"@sindresorhus/is": "^8.1.0",
		"@types/node": "~24.13.6",
		"@types/yargs": "^17.0.35",
		"defu": "^6.1.7",
		"nano-spawn": "^2.1.0",
		"yargs": "^18.2.0"
	},
	"devDependencies": {
		"@arethetypeswrong/core": "^0.18.5",
		"@kitschpatrol/chagent": "^0.5.0",
		"@kitschpatrol/shared-config": "^8.14.0",
		"brewpub": "^0.5.0",
		"bumpp": "^12.3.0",
		"mdat-plugin-cli-help": "^3.4.1",
		"publint": "^0.3.25",
		"shx": "^0.4.0",
		"tsdown": "^0.23.4",
		"typescript": "~6.0.3",
		"vitest": "^5.0.5"
	},
	"packageManager": "pnpm@12.16.1",
	"engines": {
		"node": "^24.16.0 || >=26.0.0"
	}
}
